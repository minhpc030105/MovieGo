# Set default behavior to auto-handle line endings
* text=auto

# Ensure C/C++ source code, headers, Makefiles and scripts always use LF (Linux) line endings
Makefile text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.pro text eol=lf
*.pri text eol=lf
*.md text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

